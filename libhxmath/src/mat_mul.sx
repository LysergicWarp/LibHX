/* void hx_mat_mul(const hx_mat_t *a, const hx_mat_t *b, hx_mat_t *result)
 * void hx_mat_mul_round(const hx_mat_t *a, const hx_mat_t *b, hx_mat_t *result)
 *
 * ref_mat.c is the same in C. SR's S bit is taken as clear.
 *
 * The rotation: a row of a against a column of b by mac.w, r5 stepped down the column between
 * them. The translation: a's row goes onto the stack as longs, shifted up 2, and is walked
 * against b's translation by mac.l, so the sum's middle is the result with no shift.
 *
 * r7 is what the rotation's sums start from, 0 or half a last place. r3 walks b's translation. */

        .text

        .align 2
        .global _hx_mat_mul_round
        .type _hx_mat_mul_round, @function
_hx_mat_mul_round:
        mov     #0x20, r7
        bra     .Lmultiply
        shll8   r7

        .global _hx_mat_mul
        .type _hx_mat_mul, @function
_hx_mat_mul:
        mov     #0, r7
.Lmultiply:
        mov     r5, r3
        add     #20, r3
        add     #-12, r15

        .irp    row, 0, 1, 2
        .irp    column, 0, 1, 2
        lds     r7, macl
        mac.w   @r4+, @r5+
        add     #4, r5
        mac.w   @r4+, @r5+
        add     #4, r5
        mac.w   @r4+, @r5+
        sts     macl, r0
        .if     \column == 2
        add     #-18, r5
        .else
        add     #-12, r5
        .endif
        shll2   r0
        add     #-6, r4
        shlr16  r0
        mov.w   r0, @(6*\row+2*\column, r6)
        .endr

        mov.w   @r4+, r0
        shll2   r0
        mov.l   r0, @(0, r15)
        mov.w   @r4+, r0
        shll2   r0
        mov.l   r0, @(4, r15)
        mov.w   @r4+, r0
        shll2   r0
        mov.l   r0, @(8, r15)
        mov     r7, r1
        shll2   r1
        clrmac
        lds     r1, macl
        mov     r15, r2
        mac.l   @r2+, @r3+
        mac.l   @r2+, @r3+
        mac.l   @r2+, @r3+
        mov     #14-2*\row, r0
        mov.l   @(r0, r4), r2
        sts     mach, r1
        sts     macl, r0
        xtrct   r1, r0
        add     r2, r0
        mov.l   r0, @(20+4*\row, r6)
        .if     \row < 2
        add     #-12, r3
        .endif
        .endr

        rts
        add     #12, r15
