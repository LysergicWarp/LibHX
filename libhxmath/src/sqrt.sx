/* hx_fix16_t hx_sqrt(hx_fix16_t value)
 *
 * ref_sqrt.c is the same in C. r4 is the value shifted up, r5 the scale that shifts the result
 * back. r0 walks the constants, each step loading the next one's in its branch's slot. */

        .text

        .align 2
        .global _hx_sqrt
        .type _hx_sqrt, @function
_hx_sqrt:
        cmp/pl  r4
        bf      .Lnone
        mova    .Lpool, r0
        mov.l   @r0+, r5

        /* Up by an even count into 2^30 to 2^32 */
        mov.l   @r0+, r1
        cmp/hi  r1, r4
        bt/s    1f
        mov.l   @r0+, r1
        shll16  r4
        shlr8   r5
1:
        cmp/hi  r1, r4
        bt/s    2f
        mov.l   @r0+, r1
        shll8   r4
        shlr2   r5
        shlr2   r5
2:
        cmp/hi  r1, r4
        bt/s    3f
        mov.l   @r0+, r1
        shll2   r4
        shll2   r4
        shlr2   r5
3:
        cmp/hi  r1, r4
        bt/s    4f
        mov.l   @r0, r2
        shll2   r4
        shlr    r5
4:
        /* The guess: the root by the top 8 bits, and its slope by the 8 below. Its low word
         * counts, the high is the load's sign */
        mov     r4, r0
        shlr16  r0
        extu.b  r0, r1
        shlr8   r0
        shll2   r0
        add     r2, r0
        mov.w   @r0+, r2
        mov.w   @r0, r3
        mulu.w  r1, r3
        sts     macl, r3
        shlr8   r3
        add     r3, r2

        /* What its square leaves, over the guess: 12 bits of quotient */
        mulu.w  r2, r2
        mov     r2, r3
        shll16  r3
        sts     macl, r1
        sub     r1, r4
        shll8   r4
        shll2   r4
        shll2   r4
        div0u
        .rept 12
        div1    r3, r4
        .endr
        rotcl   r4
        extu.w  r4, r4

        /* Twice the root, by the scale */
        shlr8   r3
        shll    r3
        add     r4, r3
        dmulu.l r5, r3
        rts
        sts     mach, r0

.Lnone:
        rts
        mov     #0, r0

        .align 2
.Lpool:
        .long   0x80000000
        .long   0x0000FFFF
        .long   0x00FFFFFF
        .long   0x0FFFFFFF
        .long   0x3FFFFFFF
        .long   _hx_priv_roots
