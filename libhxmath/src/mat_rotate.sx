/* void hx_mat_rotate_x_sincos(const hx_mat_t *m, const hx_sincos_t *turn, hx_mat_t *result)
 * and _y, _z. turn is read as its sine and then its cosine: hx_mat_rotate_x and its fast form
 * in the header each bring their own.
 *
 * ref_mat.c is the same in C. Two columns of the rotation change: with a the column of the axis
 * the turn takes from, b the one it takes toward,
 *   a' = a cos + b sin
 *   b' = b cos - a sin
 * A row is read whole before it is written, so the result may be m.
 *
 * r1 is the sine, r2 the cosine, r3 a, r5 b. */

#include "layout.h"

        /* One column of a row, by what it is: k kept, a, b */
        .macro  take what, offset
        .ifc    \what, k
        mov.w   @r4+, r0
        mov.w   r0, @(\offset, r6)
        .endif
        .ifc    \what, a
        mov.w   @r4+, r3
        .endif
        .ifc    \what, b
        mov.w   @r4+, r5
        .endif
        .endm

        /* The three columns by what they are, and the offsets in a row of a and b. A section a
         * turn, so a program links only the ones it calls */
        .macro  turn name, first, second, third, from, toward
        .section .text.\name, "ax", @progbits
        .align 2
        .global _\name
        .type _\name, @function
_\name:
        mov.w   @r5+, r1
        mov.w   @r5, r2

        .irp    row, 0, 1, 2
        take    \first, HX_MAT_ROW_SIZE*\row
        take    \second, HX_MAT_ROW_SIZE*\row+2
        take    \third, HX_MAT_ROW_SIZE*\row+4
        muls.w  r3, r2
        sts     macl, r0
        muls.w  r5, r1
        sts     macl, r7
        add     r7, r0
        shll2   r0
        shlr16  r0
        mov.w   r0, @(HX_MAT_ROW_SIZE*\row+\from, r6)
        muls.w  r5, r2
        sts     macl, r0
        muls.w  r3, r1
        sts     macl, r7
        sub     r7, r0
        shll2   r0
        shlr16  r0
        mov.w   r0, @(HX_MAT_ROW_SIZE*\row+\toward, r6)
        .endr

        add     #HX_MAT_TRANSLATION-HX_MAT_ROTATION_SIZE, r4
        mov.l   @r4+, r0
        mov.l   r0, @(HX_MAT_TRANSLATION+HX_VEC3_X, r6)
        mov.l   @r4+, r0
        mov.l   r0, @(HX_MAT_TRANSLATION+HX_VEC3_Y, r6)
        mov.l   @r4+, r0
        rts
        mov.l   r0, @(HX_MAT_TRANSLATION+HX_VEC3_Z, r6)
        .endm

        turn    hx_mat_rotate_x_sincos, k, a, b, 2, 4
        turn    hx_mat_rotate_y_sincos, b, k, a, 4, 0
        turn    hx_mat_rotate_z_sincos, a, b, k, 0, 2
